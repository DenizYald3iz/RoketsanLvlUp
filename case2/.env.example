# Copy to .env — NEVER commit .env
LLM_BASE_URL=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app/v1
LLM_API_KEY=sk-...
LLM_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=low
# Folder holding image_meta.json, zones.json, tracks.csv, field_reports.json, pred_all_boxes.csv, images/
DATA_DIR=data/stage2
# Abort batch runs when gateway spend (USD) exceeds this
MAX_SPEND=12
# Detection source: csv (PRED_FILE, submission format) | http (GPU server at DETECTOR_URL)
DETECTOR=csv
PRED_FILE=data/stage2/pred_all_boxes_submission.csv
DETECTOR_URL=
